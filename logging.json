{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "()": "uvicorn.logging.DefaultFormatter",
      "fmt": "%(asctime)s %(levelprefix)s %(message)s",
      "use_colors": false
    },
    "access": {
      "()": "uvicorn.logging.AccessFormatter",
      "fmt": "%(asctime)s %(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s",
      "use_colors": false
    }
  },
  "handlers": {
    "default": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "default",
      "filename": "C:\\web\\logs\\web.err.log",
      "maxBytes": 20971520,
      "backupCount": 5,
      "encoding": "utf-8"
    },
    "access": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "access",
      "filename": "C:\\web\\logs\\web.out.log",
      "maxBytes": 20971520,
      "backupCount": 5,
      "encoding": "utf-8"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["default"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["default"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["access"],
      "level": "INFO",
      "propagate": false
    }
  },
  "root": {
    "handlers": ["default"],
    "level": "INFO"
  }
}
